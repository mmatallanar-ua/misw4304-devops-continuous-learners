# Crea las tablas en RDS al desplegar. `leader_only` lo ejecuta en una sola instancia
# (con varias instancias evita carreras) y `create_all` es idempotente, así que se puede
# repetir en cada despliegue sin riesgo.
container_commands:
  01_init_db:
    command: "source /var/app/venv/*/bin/activate && flask --app application init-db"
    leader_only: true
