              "  pm.expect(body).to.have.all.keys(\"blacklisted\", \"blocked_reason\");",
              "  pm.expect(body.blacklisted).to.eql(false);",
              "  pm.expect(body.blocked_reason).to.eql(null);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
